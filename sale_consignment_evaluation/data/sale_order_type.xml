<odoo>

    <record id="consignment_sale_type" model="sale.order.type">
        <field name="name">On Consignment Order</field>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="sequence_id" ref="sale.seq_sale_order"/>
        <field name="location_dest_id" ref="stock_location_consignment"/>
        <field name="owner_mode">assign</field>
        <field name="transportation_reason_id" ref="transportation_reason_DEP"/>
        <field name="auto_validate_picking">assign</field>
        <field name="not_sale" eval="True"/>
    </record>

    <record id="evaluation_sale_type" model="sale.order.type">
        <field name="name">For Evaluation Order</field>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="sequence_id" ref="sale.seq_sale_order"/>
        <field name="location_dest_id" ref="stock_location_evaluation"/>
        <field name="owner_mode">assign</field>
        <field name="transportation_reason_id" ref="l10n_it_ddt.transportation_reason_VIS"/>
        <field name="auto_validate_picking">assign</field>
        <field name="not_sale" eval="True"/>
    </record>

</odoo>