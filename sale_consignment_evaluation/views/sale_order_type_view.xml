<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_type_plus_form_view" model="ir.ui.view">
        <field name="name">sale.order.type.plus.form.view</field>
        <field name="model">sale.order.type</field>
        <field name="inherit_id" ref="sale_order_type.sot_sale_order_type_form_view"/>
        <field name="arch" type="xml">
            <form>
                <xpath expr="/sheet//field[name='location_dest_id'" position="after">
                    <group>
                        <field name="location_dest_id"/>
                        <field name="transportation_reason_id"/>
                    </group>
                </xpath>
            </form>
        </field>
    </record>

</odoo>
