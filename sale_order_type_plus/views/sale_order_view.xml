<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="sale_order_line_view_form_delivery_method" model="ir.ui.view">
        <field name="name">sale.order.line.view.form.delivery.method</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/form/group/group/field[@name='price_unit']"
                   position="before">
                <field name="qty_delivered_method" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>